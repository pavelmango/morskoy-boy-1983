10 REM ======================================================================
20 REM МОРСКОЙ БОЙ (ОКБ "ИМПУЛЬС", 1983) // ОС ПК-ДОС 1.04 / MS-DOS QBASIC
30 REM РЕЛЯТИВИСТСКИЙ ПЕРИСКОП С ПОПРАВКОЙ ЛОРЕНЦА И ДИЛЯЦИЕЙ ВРЕМЕНИ ТОРПЕДЫ
40 REM АРХИВ ЕВГЕНИЯ ВАЛУЕВА (EUGEN VALUEV SOVEREIGN RETRO ARCHIVE)
50 REM ======================================================================
60 CLS : SCREEN 0 : WIDTH 80, 25 : COLOR 10, 0
70 PRINT "=============================================================================="
80 PRINT " СПЕЦВЫЧИСЛИТЕЛЬ ЭЛЕКТРОНИКА-КР // ПК-ДОС 1.04 // МОРСКОЙ БОЙ (1983)"
90 PRINT " ЛАБОРАТОРИЯ РЕЛЯТИВИСТСКОЙ БАЛЛИСТИКИ: d(tau) = dt * SQR(1 - (v/c)^2)"
100 PRINT "=============================================================================="
110 C = 180! : BTORP = .75! : GAMMA = 1! / SQR(1! - BTORP * BTORP)
120 AMMO = 10 : HITS = 0 : SCORE = 0
130 PRINT
140 PRINT " Скорость света полигона c_eff ="; C; "узл."
150 PRINT " Скорость торпеды v_t/c        ="; BTORP; "c"
160 PRINT " Фактор Лоренца торпеды gamma  ="; USING "#.###"; GAMMA
170 PRINT " Диляция времени d(tau)/dt     ="; USING "#.###"; 1! / GAMMA
180 PRINT
190 FOR ROUND = 1 TO 10
200   DIST = 360!
210   BSHIP = .25! + RND * .2!
220   DIR = 1 : IF RND < .5 THEN DIR = -1
230   TRUEAZ = (RND * 50! - 25!)
240   OMEGA = (DIR * BSHIP * C / DIST) * 57.2958
250   TLIGHT = DIST / C
260   APPAZ = TRUEAZ - OMEGA * TLIGHT
270   TFLIGHT = DIST / (BTORP * C)
280   TAUPROP = TFLIGHT / GAMMA
290   LEAD = OMEGA * (TLIGHT + TFLIGHT)
300   COLOR 10, 0
310   PRINT "------------------------------------------------------------------------------"
320   PRINT "ТОРПЕДА #"; ROUND; "| Дистанция D="; DIST; "| Скорость цели beta_s="; USING "#.##c"; BSHIP
330   PRINT "Видимый в перископе азимут цели (запаздывание света): "; USING "+##.# град."; APPAZ
340   PRINT "Направление хода цели: "; : IF DIR > 0 THEN PRINT "ВПРАВО (+)" ELSE PRINT "ВЛЕВО (-)"
350   COLOR 14, 0
360   INPUT "Введите азимут пуска релятивистской торпеды (град.): ", FIREAZ
370   SOUND 520, 3 : SOUND 340, 4
380   INTAZ = TRUEAZ + OMEGA * TFLIGHT
390   ERRDEG = ABS(FIREAZ - INTAZ)
400   PRINT "Лабораторное время хода t_лаб = "; USING "##.## с"; TFLIGHT;
410   PRINT " | Собственное время торпеды tau = "; USING "##.## с"; TAUPROP
420   IF ERRDEG <= 2.5 THEN
430     COLOR 12, 0 : SOUND 160, 8 : SOUND 110, 10
440     HITS = HITS + 1 : SCORE = SCORE + INT(200 * GAMMA)
450     PRINT ">>> ЦЕЛЬ ПОРАЖЕНА! Точный релятивистский перехват в азимуте "; USING "+##.# град."; INTAZ
460   ELSE
470     COLOR 7, 0 : SOUND 200, 3
480     PRINT "--- ПРОМАХ! Истинная точка встречи была "; USING "+##.# град."; INTAZ; " (поправка Лоренца "; USING "+##.#)"; LEAD
490   END IF
500 NEXT ROUND
510 COLOR 10, 0
520 PRINT "=============================================================================="
530 PRINT " ИТОГ БОЕВОГО ДЕЖУРСТВА: Потоплено "; HITS; " из 10 | Очки: "; SCORE
540 PRINT "=============================================================================="
550 END
